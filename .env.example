# Local docker compose: create .env only when absent; never overwrite existing configuration.
# Then set AI__API_KEY, or explicitly select fake/fake-1 for offline use.
# Local development credentials only. Never reuse them anywhere else.
# Nested groups use a double underscore (pydantic-settings, env_nested_delimiter="__").

# Compose packaging only (not read by application code). Changing the project name
# isolates containers, networks, named volumes AND built api/worker/web image tags.
COMPOSE_PROJECT_NAME=ballasttasks
# For an alternate file set BT_ENV_FILE to its absolute path AND pass --env-file <path>.
# The former selects API/worker runtime settings; the latter Compose interpolation.
BT_ENV_FILE=.env
# Published on 127.0.0.1 only. Changing these requires matching browser URLs/CORS below.
BT_API_PORT=8000
BT_WEB_PORT=3000

# App: runtime mode of the API and the worker
APP__ENV=development
APP__DEBUG=true
# Optional: seconds each readiness check may take before it is reported as failed
APP__HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# PostgreSQL image: creates this user and database on first start
POSTGRES_USER=ballast
POSTGRES_PASSWORD=ballast
POSTGRES_DB=ballasttasks

# Database: must match the POSTGRES_* values above; `db` is the compose service name
DATABASE__URL=postgresql+psycopg://ballast:ballast@db:5432/ballasttasks

# Attachments: registry-selected FileStorage; local files persist in a named API volume.
STORAGE__PROVIDER=local
# Under compose this is both the API's directory and the volume's mount point. The image
# creates and owns this one path for the non-root server (apps/api/Dockerfile); another
# path has to be added there too, or the first upload fails with a permission error.
STORAGE__LOCAL_DIRECTORY=/var/lib/ballasttasks/attachments
# Per-file limit, checked as bytes arrive (10 MiB).
STORAGE__MAX_BYTES=10485760

# Redis: Celery broker and readiness check; `redis` is the compose service name
REDIS__URL=redis://redis:6379/0

# AI: which LanguageModel adapter the API and the worker use. Switching provider is an
# edit of these lines only. OpenRouter is the normal default and REQUIRES a key.
AI__PROVIDER=openrouter
# A model alias, not a preset: keep the leading ~. It tracks the latest GPT Luna model.
AI__MODEL=~openai/gpt-luna-latest
# Explicit offline/test choice (set BOTH lines); never a fallback for a rejected/missing key:
#AI__PROVIDER=fake
#AI__MODEL=fake-1
# Alternative: Google's Gemini API directly (ids at https://ai.google.dev/gemini-api/docs/models)
#AI__PROVIDER=gemini
#AI__MODEL=gemini-3.8-flash
# Secret. Required by `openrouter` and `gemini`: the API refuses to start without it.
# `fake` needs none. Never commit a real key.
AI__API_KEY=
# Optional: API ROOT only, not a model page or /chat/completions URL. Blank is recommended.
# Replaces the adapter's endpoint (a proxy or gateway). Defaults:
# openrouter https://openrouter.ai/api/v1, gemini https://generativelanguage.googleapis.com/v1beta
AI__BASE_URL=
# Optional: seconds one generation may take in total (connection retry and response body
# included) before it fails as a timeout. A draft step generation job waits at most 240 of
# them, whatever this says (docs/architecture.md#queued-step-generation).
AI__TIMEOUT_SECONDS=30
# Optional: seconds the provider's answer to the readiness check is reused, so the public
# GET /health/ready cannot be used to drive calls made with the key. 0 turns the cache off.
AI__CHECK_CACHE_SECONDS=30

# Auth: HMAC key that signs the access tokens. LOCAL DEVELOPMENT VALUE ONLY: anywhere else
# generate your own with `openssl rand -hex 32`. The API refuses to start when it is missing
# or shorter than the algorithm's digest (HS256: 32 bytes, HS384: 48, HS512: 64).
AUTH__JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789abcdef
AUTH__JWT_ALGORITHM=HS256
# Minutes an access token stays valid; there are no refresh tokens, so login again after that
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=30

# Single sign-on: DISABLED by default; no SSO credentials are needed and
# password login (POST /auth/login) keeps working. Enable providers by name, as a JSON list.
#   '["google"]' needs an OAuth 2.0 Web client from Google Cloud Console (APIs & Services >
#                Credentials) whose authorised redirect URI is exactly
#                <SSO__API_PUBLIC_BASE_URL>/auth/sso/google/callback
#                The API refuses to start while google is enabled without both values below.
#   '["fake"]'   needs nothing and signs in a fixed demo user: local demos and tests only
#                (the API refuses to start with it when APP__ENV=production).
SSO__ENABLED_PROVIDERS='[]'
SSO__GOOGLE_CLIENT_ID=
# Secret: never commit a real value. It is never logged or echoed in a startup error.
SSO__GOOGLE_CLIENT_SECRET=
# The API as the browser and the provider reach it; the provider's redirect URI is built from it.
# It may carry a path (https://host/api behind a proxy): the sign-in cookie is scoped under it.
SSO__API_PUBLIC_BASE_URL=http://localhost:8000
# Where the web app receives the one-time code (?code=...) or a failure (?error=...).
# These two URLs are the only redirect targets single sign-on uses; no request can change them.
SSO__WEB_CALLBACK_URL=http://localhost:3000/auth/callback

# Rate limiting: fixed windows counted in Redis; when Redis is unreachable the API keeps serving
# and each process counts on its own (docs/decisions/0004-rate-limiting.md). Every line is
# optional; these are the defaults. Every response of a limited route carries
# X-RateLimit-Limit / -Remaining / -Reset, and a 429 adds Retry-After.
RATE_LIMIT__ENABLED=true
# true ONLY behind a reverse proxy that sets X-Forwarded-For itself: the client address is then
# the last entry of that header. Anywhere else a client could forge it and dodge the limits.
RATE_LIMIT__TRUST_PROXY=false
# Prefix of the Redis keys, so environments that share one Redis keep separate counters
RATE_LIMIT__KEY_PREFIX=ratelimit
# Credential routes (login/register, session login/SSO, SSO callback/exchange), per client IP
RATE_LIMIT__AUTH__LIMIT=10
RATE_LIMIT__AUTH__WINDOW_SECONDS=60
# Every other limited route with a valid bearer or browser cookie, per user id
RATE_LIMIT__AUTHENTICATED__LIMIT=120
RATE_LIMIT__AUTHENTICATED__WINDOW_SECONDS=60
# Every other route without a valid token, per client IP. /health and /health/ready are exempt.
RATE_LIMIT__ANONYMOUS__LIMIT=60
RATE_LIMIT__ANONYMOUS__WINDOW_SECONDS=60

# Browser cookies/CSRF: exact same-site web origins, no wildcard, path or credentials.
# HTTPS is required in production (cookies are Secure); HTTP is allowed only on loopback.
# Match localhost vs 127.0.0.1 between web/API. Ports do not isolate host cookies.
# CORS: JSON list of browser origins allowed to call the API
CORS__ALLOWED_ORIGINS='["http://localhost:3000"]'

# Web: API base URL as seen from the browser (inlined into the Next.js build)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Real authenticated API by default. "demo" is an explicit offline UI/visual-test mode.
NEXT_PUBLIC_SERVICE_MODE=http
# Opt-in HTTP adapter/browser contracts, against verified disposable local services only.
# Both bindings are required; no default endpoints or stack lifecycle operations.
# Never point this at a user's stack. Tests naturally wait 61s between credential groups.
#BT_HTTP_API_URL=http://127.0.0.1:48417
#BT_HTTP_WEB_URL=http://127.0.0.1:48418

# Visual tests also require NEXT_PUBLIC_API_URL, even with offline task fixtures.
# Web visual tests only (`npm run test:visual`), never read by the app: folder holding the
# design snapshot ("Ballast Tasks v2.dc.html" + support.js), which is kept outside the
# repository. Unset, the comparisons against the design skip themselves.
# BT_DESIGN_DIR=/path/to/design-v2
# Ports the visual suite serves the app and the design on. Both servers are reused when
# already running, so set a private pair when two checkouts run the suite at the same time.
# BT_VISUAL_APP_PORT=47812
# BT_VISUAL_DESIGN_PORT=47811
